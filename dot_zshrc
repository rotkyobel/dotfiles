export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

typeset -U PATH path FPATH fpath

# Keep PATH entries idempotent.
path_prepend() {
  local dir="$1"
  [[ -d "$dir" ]] || return
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) export PATH="$dir:$PATH" ;;
  esac
}

# Docker CLI completions need to be in fpath before Oh My Zsh runs compinit.
[[ -d "$HOME/.docker/completions" ]] && fpath=("$HOME/.docker/completions" $fpath)

plugins=(
  git
  sudo
  gh
)

source "$ZSH/oh-my-zsh.sh"

# aliases
alias grep='grep --color=auto'
alias cat='bat --style=plain --paging=never'
alias ls='eza --group-directories-first'
alias l='eza --group-directories-first -l'
alias ll='eza --group-directories-first -l'
alias la='eza --group-directories-first -la'
alias tree='eza -T'

# claude code
alias yolo='claude --dangerously-skip-permissions'   # skips all permission prompts
alias ccc='claude --continue'                        # continue most recent session
alias ccr='claude --resume'                          # pick a session to resume
alias ccu='claude update'

# misc
alias zshrc='${EDITOR:-vim} ~/.zshrc'
alias reload='exec zsh'
alias path='echo $PATH | tr ":" "\n"'
alias ports='lsof -iTCP -sTCP:LISTEN -P -n'
alias dsclean='find . -name .DS_Store -type f -delete'


# mise
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Prefer user-managed wrappers over mise-managed binaries.
path=("$HOME/.local/bin" $path)
export PATH

# Set up fzf key bindings and fuzzy completion
if command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
  source <(fzf --zsh)
fi

# zoxide
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# Homebrew zsh plugins (syntax highlighting should stay last among prompt hooks).
if command -v brew >/dev/null 2>&1; then
  BREW_PREFIX="${BREW_PREFIX:-$(brew --prefix)}"
  [[ -r "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [[ -r "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Load Angular CLI autocompletion (cached to avoid running ng on every shell startup).
if command -v ng >/dev/null 2>&1 && (( $+functions[compdef] )); then
  NG_COMPLETION_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/ng-completion.zsh"
  if [[ ! -r "$NG_COMPLETION_CACHE" || "$(command -v ng)" -nt "$NG_COMPLETION_CACHE" ]]; then
    mkdir -p "${NG_COMPLETION_CACHE:h}"
    ng completion script >| "$NG_COMPLETION_CACHE.tmp" 2>/dev/null && mv "$NG_COMPLETION_CACHE.tmp" "$NG_COMPLETION_CACHE"
    rm -f "$NG_COMPLETION_CACHE.tmp"
  fi
  [[ -r "$NG_COMPLETION_CACHE" ]] && source "$NG_COMPLETION_CACHE"
fi

# instantclient
export INSTANT_CLIENT_HOME="/opt/oracle/instantclient_23_3"
path_prepend "$INSTANT_CLIENT_HOME"
if [[ -d "$INSTANT_CLIENT_HOME" && ":${DYLD_LIBRARY_PATH:-}:" != *":$INSTANT_CLIENT_HOME:"* ]]; then
  export DYLD_LIBRARY_PATH="$INSTANT_CLIENT_HOME${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
fi

# bun completions
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# local tools
path_prepend "$HOME/.local/bin"

[[ ":$PATH:" != *":$HOME/.config/kaku/zsh/bin:"* ]] && export PATH="$HOME/.config/kaku/zsh/bin:$PATH" # Kaku PATH Integration
[[ -f "$HOME/.config/kaku/zsh/kaku.zsh" ]] && source "$HOME/.config/kaku/zsh/kaku.zsh" # Kaku Shell Integration

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
path_prepend "$PNPM_HOME/bin"
# pnpm end
