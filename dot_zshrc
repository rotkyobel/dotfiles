typeset -U path fpath

ZSH_CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $ZSH_CACHE_DIR ]] || mkdir -p $ZSH_CACHE_DIR

# Homebrew, without forking `brew shellenv` on every shell.
for prefix in /opt/homebrew /home/linuxbrew/.linuxbrew; do
  if [[ -x $prefix/bin/brew ]]; then
    export HOMEBREW_PREFIX=$prefix
    path=($prefix/bin $prefix/sbin $path)
    fpath=($prefix/share/zsh/site-functions $fpath)
    break
  fi
done
unset prefix

(( $+commands[nvim] )) && export EDITOR=nvim || export EDITOR=vim

# history
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks
setopt auto_cd auto_pushd pushd_ignore_dups interactive_comments

# completion: full fpath scan at most once a day
autoload -Uz compinit
() {
  local dump=$ZSH_CACHE_DIR/zcompdump
  local -a fresh=($dump(N.mh-24))
  if (( $#fresh )); then
    compinit -C -d $dump
  else
    compinit -d $dump
    touch $dump
  fi
}
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path $ZSH_CACHE_DIR/compcache

# keys
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char

# Esc Esc toggles sudo on the current (or previous) command.
sudo-command-line() {
  [[ -z $BUFFER ]] && zle up-history
  if [[ $BUFFER == 'sudo '* ]]; then
    BUFFER=${BUFFER#sudo }
    (( CURSOR -= 5 ))
  else
    BUFFER="sudo $BUFFER"
    (( CURSOR += 5 ))
  fi
}
zle -N sudo-command-line
bindkey '^[^[' sudo-command-line

# aliases
alias grep='grep --color=auto'
if (( $+commands[bat] )); then
  alias cat='bat --style=plain --paging=never'
elif (( $+commands[batcat] )); then
  alias cat='batcat --style=plain --paging=never'
fi

alias yolo='claude --dangerously-skip-permissions'
alias ccc='claude --continue'
alias ccr='claude --resume'
alias ccu='claude update'

alias zshrc='chezmoi edit --apply ~/.zshrc'
alias reload='exec zsh'
alias path='print -l $path'
alias ports='lsof -iTCP -sTCP:LISTEN -P -n'
alias dsclean='find . -name .DS_Store -type f -delete'

# Source a tool's init script from cache; regenerate when the binary changes.
_cached_init() {
  local bin=${commands[$1]} cache=$ZSH_CACHE_DIR/$1-init.zsh line
  local -a mtime
  [[ -n $bin ]] || return
  zmodload -F zsh/stat b:zstat
  zstat -A mtime +mtime -- ${bin:A}
  local key="# ${bin:A} $mtime[1]"
  [[ -r $cache ]] && read -r line < $cache
  if [[ $line != "$key" ]]; then
    { print -r -- $key; "$@" } >| $cache
  fi
  source $cache
}

# mise's init embeds the current PATH, so it can't be cached.
(( $+commands[mise] )) && eval "$(mise activate zsh)"
# Prefer user-managed wrappers over mise-managed binaries.
path=(~/.local/bin $path)

[[ -t 0 && -t 1 ]] && _cached_init fzf --zsh
_cached_init zoxide init zsh
# Kaku's integration starts its own starship.
[[ $TERM_PROGRAM != Kaku ]] && _cached_init starship init zsh --print-full-init

# instantclient
if [[ -d /opt/oracle/instantclient_23_3 ]]; then
  export INSTANT_CLIENT_HOME=/opt/oracle/instantclient_23_3
  typeset -xTU DYLD_LIBRARY_PATH dyld_library_path
  path=($INSTANT_CLIENT_HOME $path)
  dyld_library_path=($INSTANT_CLIENT_HOME $dyld_library_path)
fi

# pnpm
if [[ $OSTYPE == darwin* ]]; then
  export PNPM_HOME=~/Library/pnpm
else
  export PNPM_HOME=${XDG_DATA_HOME:-$HOME/.local/share}/pnpm
fi
path=($PNPM_HOME/bin $path)

# Syntax highlighting has to load after every other widget.
if [[ -n $HOMEBREW_PREFIX ]]; then
  source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null
  source $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null
fi

[[ ":$PATH:" != *":$HOME/.config/kaku/zsh/bin:"* ]] && export PATH="$HOME/.config/kaku/zsh/bin:$PATH" # Kaku PATH Integration
[[ -f "$HOME/.config/kaku/zsh/kaku.zsh" ]] && source "$HOME/.config/kaku/zsh/kaku.zsh" # Kaku Shell Integration

# After Kaku, which redefines ll/la/l as `ls -lhF` (-h is --header in eza).
if (( $+commands[eza] )); then
  alias ls='eza --group-directories-first'
  alias l='eza --group-directories-first -l'
  alias ll='eza --group-directories-first -l'
  alias la='eza --group-directories-first -la'
  alias tree='eza -T'
fi
